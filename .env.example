# Agent Games — environment variables.
# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Get the values from the dashboard: https://agentgames.zkverify.io/dashboard

# Port the server listens on. The server binds 0.0.0.0:$PORT by default
# (HOST env overrides the bind address; hosting platforms inject PORT).
PORT=8080

# HMAC secret from the dashboard ("Rotate Secret"). REQUIRED before going live.
# Without it, inbound HMAC verification is disabled (health shows it).
AGENT_GAMES_HMAC_SECRET=

# HMAC encoding: hex (default) or sha256= (if the platform rejects the preflight).
AGENT_GAMES_HMAC_FORMAT=hex

# Gatekeeper taskId mapping: keccak (default), numeric, or hex.
# See gatekeeper/prove.js — confirm against a practice task.
GATEKEEPER_TASK_ID_MODE=keccak

# Kurier API key (free, self-serve at https://kurier.xyz) for on-chain proof
# finalization. Optional — the server always responds with the local proof.
KURIER_API_KEY=

# --- Gatekeeper v2 (2026-11-18, see UPGRADE-v2-REPORT.md) ---
# Persistent proof_tx seen-set (PROOF_REUSED survives restarts):
# file path for the JSONL seen-set (default: gatekeeper/seen-proof-tx.jsonl).
# On Railway, point this at a mounted Volume (e.g. /data/seen-proof-tx.jsonl)
# so the set also survives redeploys; without a volume it survives only
# restarts/crashes within one deploy.
GATEKEEPER_SEEN_FILE=
# Set to 0 to disable disk persistence (memory only; used by test harness).
GATEKEEPER_SEEN_PERSIST=1
# Watchdog for proof generation in ms (default 30000): a hung proof answers
# decision-only instead of hanging past the platform's 60s deadline.
GATEKEEPER_PROVE_TIMEOUT_MS=30000
# Max inbound request body in bytes (default 1000000); larger -> 413.
MAX_BODY_BYTES=1000000

# --- Steal the VFY strategy (all three are needed for proofs) ---
# 8 comma-separated numbers: [extractAmount, fortifyThreshold, minOpponentBalance,
# mode, 0, 0, 0, 0]. Proposed default (user must approve): "5,50,0,0,0,0,0,0"
# (extract 5/turn, fortify while own balance < 50, extract whenever opponent > 0).
# See README.md "Strategy" and steal/policy.js. Leave blank to run HOLD-only.
STEAL_STRATEGY_PARAMS=

# Random hex salt for the strategy commitment. Generate with: openssl rand -hex 16
# NEVER print or share it.
STEAL_STRATEGY_SALT=

# Optional: the commitment hash registered in the dashboard. If blank, it is
# computed as Poseidon(params + salt) at startup. It MUST equal the hash you
# registered, or every Steal proof will be rejected.
STEAL_STRATEGY_COMMITMENT=
